# =============================================================================
# ENVIRONMENT VARIABLES — Educational Meme Coin Detection System
# =============================================================================
# DISCLAIMER: For educational and testing purposes only. Devnet use only.
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Network — controls which Solana cluster is used across Python and JS
# Set to "mainnet" for real deployments (DANGEROUS — uses real SOL)
# ---------------------------------------------------------------------------
NETWORK=devnet
# NETWORK=mainnet

# ---------------------------------------------------------------------------
# Solana wallet path (devnet keypair ONLY unless deploying to mainnet)
# ---------------------------------------------------------------------------
WALLET_KEYPAIR_PATH=~/.config/solana/devnet-test.json

# ---------------------------------------------------------------------------
# RPC endpoints (free public or free-tier private)
# These are overridden automatically based on NETWORK when left blank
# ---------------------------------------------------------------------------
PRIMARY_RPC=https://api.devnet.solana.com
FALLBACK_RPC=https://devnet.helius-rpc.com
WS_RPC=wss://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Free metadata hosting API keys (optional)
# nft.storage: sign up free at https://nft.storage
# web3.storage: sign up free at https://web3.storage
# ---------------------------------------------------------------------------
NFT_STORAGE_API_KEY=
WEB3_STORAGE_API_KEY=

# ---------------------------------------------------------------------------
# Database path
# ---------------------------------------------------------------------------
DB_PATH=data/meme_detector.db

# ---------------------------------------------------------------------------
# Playwright settings
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Bot behavior
# ---------------------------------------------------------------------------
# Set to "1" to enable the approval gate (MUST be 1 for safety)
REQUIRE_APPROVAL=1
# Loop delay in seconds between monitor cycles
MONITOR_INTERVAL=60
