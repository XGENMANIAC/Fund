# =============================================================================
# ENVIRONMENT VARIABLES
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NETWORK=mainnet
# NETWORK=devnet

# ---------------------------------------------------------------------------
# Wallet — CHOOSE ONE method:
#
# Method A (recommended for cloud/Railway):
#   Base64-encode your keypair and paste here. The private key is stored
#   only in Railway's encrypted variable storage, never on disk.
#
#   Generate the value:
#     python3 -c "
import base64, sys
print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())
" ~/.config/solana/mainnet.json
#
# WALLET_KEYPAIR_JSON=<paste base64 output here>
#
# Method B (local dev only):
#   Point to a local keypair file.
# ---------------------------------------------------------------------------
# WALLET_KEYPAIR_JSON=
WALLET_KEYPAIR_PATH=~/.config/solana/mainnet.json

# ---------------------------------------------------------------------------
# RPC endpoints
# For mainnet, use a private RPC (Helius, QuickNode) — public ones rate-limit.
# Free Helius key: https://helius.dev
# ---------------------------------------------------------------------------
PRIMARY_RPC=https://api.mainnet-beta.solana.com
FALLBACK_RPC=https://rpc.ankr.com/solana
WS_RPC=wss://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Metadata hosting (optional)
# ---------------------------------------------------------------------------
NFT_STORAGE_API_KEY=
WEB3_STORAGE_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_PATH=data/meme_detector.db

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
REQUIRE_APPROVAL=1
MONITOR_INTERVAL=60
