# =============================================================================
# ENVIRONMENT VARIABLES
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NETWORK=mainnet
# NETWORK=devnet

# ---------------------------------------------------------------------------
# Wallet — CHOOSE ONE method (checked in priority order):
#
# Method A — Solflare / Phantom export (simplest for browser wallet users):
#   In Solflare: Settings → Security → Export Private Key → copy the string.
#   In Phantom:  Settings → (your account) → Export Private Key → copy.
#   Paste the base58 string directly:
#
# WALLET_PRIVATE_KEY=<paste Solflare/Phantom base58 private key here>
#
# Method B — Base64-encoded keypair (recommended for Railway / cloud):
#   Base64-encode your solana-keygen .json file and paste here.
#
#   Generate the value:
#     python3 -c "
import base64, sys
print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())
" ~/.config/solana/mainnet.json
#
#   Or convert from a Solflare base58 export:
#     python3 -c "
import base64, json, sys
import base58
raw = base58.b58decode(sys.argv[1])
print(base64.b64encode(json.dumps(list(raw)).encode()).decode())
" YOUR_BASE58_KEY_HERE
#
# WALLET_KEYPAIR_JSON=<paste base64 output here>
#
# Method C — Local keypair file (local dev only):
# ---------------------------------------------------------------------------
# WALLET_PRIVATE_KEY=
# WALLET_KEYPAIR_JSON=
WALLET_KEYPAIR_PATH=~/.config/solana/mainnet.json

# ---------------------------------------------------------------------------
# RPC endpoints
# For mainnet, use a private RPC (Helius, QuickNode) — public ones rate-limit.
# Free Helius key: https://helius.dev
# ---------------------------------------------------------------------------
PRIMARY_RPC=https://api.mainnet-beta.solana.com
FALLBACK_RPC=https://rpc.ankr.com/solana
WS_RPC=wss://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Metadata hosting (optional)
# ---------------------------------------------------------------------------
NFT_STORAGE_API_KEY=
WEB3_STORAGE_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_PATH=data/meme_detector.db

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
REQUIRE_APPROVAL=1
MONITOR_INTERVAL=60
