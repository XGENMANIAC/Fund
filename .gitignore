# =============================================================================
# .gitignore — Solana Meme Coin Educational System
# CRITICAL: Never commit wallet keypairs, .env files, or real private keys
# =============================================================================

# Environment & secrets (NEVER commit these)
.env
*.json.key
*.pem
*.ppk

# Solana keypairs — DANGER: accidental commit = lost funds
# Even devnet keypairs should not be committed (habit formation)
**/solana/devnet-test.json
**/solana/*.json
!js/package.json
!**/schema.sql

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.egg

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Data directory (local SQLite DB, logs, metadata — don't commit)
data/
!data/.gitkeep

# Streamlit
.streamlit/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp
/tmp/
